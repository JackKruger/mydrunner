{
  "name": "mydrunner",
  "version": "0.0.0",
  "private": true,
  "description": "Browser-based multiplayer off-road physics game (MudRunner-inspired)",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter '@mydrunner/*' run dev",
    "dev:server": "pnpm --filter @mydrunner/server run dev",
    "dev:client": "pnpm --filter @mydrunner/client run dev",
    "build": "pnpm -r --filter '@mydrunner/*' run build",
    "typecheck": "pnpm -r --filter '@mydrunner/*' run typecheck",
    "test": "pnpm --filter @mydrunner/shared --filter @mydrunner/server --filter @mydrunner/client run test",
    "test:e2e": "pnpm --filter @mydrunner/e2e run test",
    "lint": "pnpm -r --filter '@mydrunner/*' run lint",
    "clean": "pnpm -r exec rm -rf dist node_modules/.vite .turbo"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "tsx": "4.23.1",
    "vitest": "4.1.10"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "0.28.1",
      "postcss": "8.5.23",
      "vite": "8.2.0"
    }
  }
}
